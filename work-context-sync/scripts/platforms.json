{
  "version": 1,
  "platforms": [
    {
      "id": "workbuddy",
      "name": "WorkBuddy",
      "vendor": "腾讯",
      "description": "腾讯 WorkBuddy AI 办公助手",
      "conversation_logs_patterns": [
        "~/.workbuddy/projects/*/*.jsonl"
      ],
      "sessions_index": "~/.workbuddy/app/sessions.json",
      "memory_dir_pattern": "{workspace}/.workbuddy/memory/",
      "log_format": "jsonl",
      "supported": true,
      "parser": "workbuddy"
    },
    {
      "id": "tongyi-lingma",
      "name": "通义灵码",
      "vendor": "阿里云",
      "description": "阿里云通义灵码 AI 编程助手（Tongyi Lingma）",
      "conversation_logs_patterns": [
        "~/.tongyi/lingma/chat-history/*",
        "~/.lingma/logs/*.jsonl",
        "~/.lingma/*.jsonl"
      ],
      "sessions_index": null,
      "memory_dir_pattern": null,
      "log_format": "jsonl",
      "supported": false,
      "parser": "tongyi-lingma",
      "note": "对话历史可能加密存储在 ~/.tongyi/lingma/chat-history/，明文日志在 ~/.lingma/logs/"
    },
    {
      "id": "baidu-comate",
      "name": "文心快码 Comate",
      "vendor": "百度",
      "description": "百度文心快码 AI 编程助手（Baidu Comate）",
      "conversation_logs_patterns": [
        ".comate/**"
      ],
      "sessions_index": null,
      "memory_dir_pattern": "{workspace}/.comate/",
      "log_format": "unknown",
      "supported": false,
      "parser": "baidu-comate",
      "note": "会话主要云端同步，本地 .comate 目录存 Memory，本地会话记录较少"
    },
    {
      "id": "huawei-codearts",
      "name": "CodeArts Agent",
      "vendor": "华为云",
      "description": "华为云 CodeArts Agent / CodeArts Snap AI 编程助手",
      "conversation_logs_patterns": [
        "~/AppData/Roaming/codearts-agent/User/chat_sessions/*",
        "~/AppData/Roaming/Code/User/chat_sessions/*",
        "~/.codeartsdoer/codearts-data/opencode.db"
      ],
      "sessions_index": null,
      "memory_dir_pattern": null,
      "log_format": "directory",
      "supported": false,
      "parser": "huawei-codearts",
      "note": "chat_sessions 目录存会话记录，opencode.db 是 SQLite 数据库"
    }
  ]
}
